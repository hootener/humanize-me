<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/marked/12.0.2/marked.min.js"></script>
<script>
const DATA = __DATA__;
// Two independent channels, because these are two independent facts.
//
//   FILL   = what kind of document this is (type)
//   RING   = where it stands (status)
//
// They used to share one channel: colorOf was STATUS_COLORS[status] ||
// TYPE_COLORS[type], so the same colour meant status on a node that had one and
// type on a node that did not — and `active` and `spec` were even the same hex.
//
// Fills are deliberately muted: type is categorical and does not need to shout.
// Rings are saturated, because status is what you scan a graph for.
// Grouped by the four categories of D0002, in left-to-right order, so the
// legend reads as the model rather than as an alphabet. `bin/diagram` paints
// docs/lineage.svg from these same hexes; a mismatch between the two is a
// drift the README would show and nobody would notice.
const TYPE_FILL = {
  goal:                 '#a5d6a7',   // Intent
  decision:             '#b39ddb',
  principle:            '#f0a8c0',
  plan:                 '#f5bd8f',   // Approach
  spec:                 '#9ecbe8',
  task:                 '#aebdd4',   // Action
  evidence:             '#9fd8cf',   // Evidence (was `context`, D0002)
  glossary:             '#e6d08a',   // outside the four: definitional
};
const NO_TYPE_FILL = '#d8dbe0';   // index, README, log, howto, TODO
const fillOf = n => TYPE_FILL[n.meta.type] || NO_TYPE_FILL;

// A ring is drawn only when status says something worth seeing. `active` and
// `stable` are the resting state, so they get the default hairline.
const STATUS_RING = {
  'draft':                 {c:'#eab308', dash:'3 2'},
  'superseded':            {c:'#6b7280', dash:'3 2'},
  'deprecated':            {c:'#6b7280', dash:'3 2'},
  'Not Ready':             {c:'#9ca3af', dash:'3 2'},
  // The task lifecycle's own `Superseded`, distinct from a document's
  // lowercase `superseded`. Missing here, a superseded ticket drew no ring at
  // all and read as an ordinary node.
  'Superseded':            {c:'#6b7280', dash:'3 2'},
  'Ready for Development': {c:'#2563eb'},
  'In Progress':           {c:'#f59e0b'},
  'Testing':               {c:'#7c3aed'},
  'Complete':              {c:'#10b981'},
  'Delivered':             {c:'#047857'},
};
const ringOf = n => STATUS_RING[n.meta.status] || null;
// "Ready for Development" has spaces, which the filter splits on. Normalising
// both sides to a hyphenated slug lets @ready-for-development work, while
// plain @ready still substring-matches.
const norm = v => String(v || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
// Kept for the panel's status chip, which wants one colour for the status.
const colorOf = n => (ringOf(n) || {c:'#94a3b8'}).c;
// Label by the frontmatter title, which is what a person reading the graph is
// looking for. Titles run long, so they are truncated on a word boundary where
// one is near the limit; the full title and path are in the hover tooltip and
// the panel. Files with no title (index, README, log) keep the filename, with
// their folder prefixed so a dozen of them stay distinct.
const LABEL_MAX = 34;
const fileLabel = n => {
  const parts = n.path.split('/');
  const f = parts.pop().replace(/\.md$/, '');
  return /^(index|README|TODO|log|howto)$/i.test(f) && parts.length ? `${parts.pop()}/${f}` : f;
};
const titleOf = n => {
  const t = (n.meta && n.meta.title || '').trim();
  if (!t) return fileLabel(n);
  if (t.length <= LABEL_MAX) return t;
  const cut = t.slice(0, LABEL_MAX);
  const sp = cut.lastIndexOf(' ');
  return (sp > LABEL_MAX - 12 ? cut.slice(0, sp) : cut.trimEnd()) + '…';
};
const byPath = new Map(DATA.nodes.map(n => [n.path, n]));
document.getElementById('meta').textContent = `${DATA.nodes.length} files  ${DATA.links.length} links  ${DATA.generated.replace('T',' ').slice(0,16)}Z`;
// Declared here, not beside the panel code: the legend escapes labels at
// module level, so a const declared later is still in its dead zone.
const esc = s => String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const legend = document.getElementById('legend');
// Keyboard accelerators. Each legend entry claims the first letter of its own
// name that nothing else has taken, so the key is always visible in the word
// itself — [D]ecision, g[L]ossary, Read[Y] for Development. Entries that run
// out of free letters fall back to a digit. Keys are unique across both rows,
// because one keystroke has to be unambiguous.
const ACCEL = new Map();
// Keyboard accelerators. Every entry wants a letter from its own name so the
// key is visible in the word — [D]ecision, g[L]ossary, De[P]recated — and no
// two entries may share one, since a keystroke has to be unambiguous.
//
// Claiming greedily in order runs out: by the time it reaches "deprecated"
// every one of d,e,p,r,c,a,t is spoken for, and three entries fall back to
// digits. This is a bipartite matching problem, so solve it as one — Kuhn's
// augmenting path lets a later entry displace an earlier one onto a different
// letter of its own name. Only entries with no possible letter take a digit.
function assignAccels(labels, weight){
  const cand = labels.map(l =>
    [...new Set(l.toLowerCase().split('').filter(c => c >= 'a' && c <= 'z'))]);
  // Kuhn's augmenting path. Candidates stay in word order so a first letter is
  // tried before a later one.
  const run = order => {
    const owner = new Map();
    const augment = (u, seen) => {
      for (const c of cand[u]) {
        if (seen.has(c)) continue;
        seen.add(c);
        if (!owner.has(c) || augment(owner.get(c), seen)) { owner.set(c, u); return true; }
      }
      return false;
    };
    order.forEach(u => augment(u, new Set()));
    const keys = new Array(labels.length).fill(null);
    owner.forEach((u, c) => { keys[u] = c; });
    // Cardinality first, then naturalness: the total distance of each key from
    // the start of its own word, weighted. [D]ecision beats d[E]cision, and a
    // weight lets the primary channel win a contested letter — decision labels
    // 14 nodes and deprecated labels none, so decision should get D.
    let size = 0, cost = 0;
    keys.forEach((k, i) => {
      if (!k) { cost += 50; return; }
      size++; cost += weight[i] * labels[i].toLowerCase().indexOf(k);
    });
    return { keys, size, cost };
  };
  // Which entry claims first decides who gets their first letter, so try a
  // spread of orders and keep the best. Seeded, so the keymap is stable.
  const idx = labels.map((_, i) => i);
  const byTightness = idx.slice().sort((a, b) => cand[a].length - cand[b].length || a - b);
  let best = null, seed = 7;
  const rnd = () => (seed = (seed * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff;
  const orders = [idx, byTightness, idx.slice().reverse()];
  for (let t = 0; t < 200; t++) {
    const o = idx.slice();
    for (let i = o.length - 1; i > 0; i--) { const j = (rnd() * (i + 1)) | 0; [o[i], o[j]] = [o[j], o[i]]; }
    orders.push(o);
  }
  for (const o of orders) {
    const r = run(o);
    if (!best || r.size > best.size || (r.size === best.size && r.cost < best.cost)) best = r;
  }
  const keys = best.keys;
  let d = 1;
  for (let i = 0; i < keys.length; i++) if (!keys[i] && d <= 9) keys[i] = String(d++);
  return keys;
}
function accelHtml(label, key){
  if (!key) return esc(label);
  const i = label.toLowerCase().indexOf(key);
  if (i < 0) return `<b class="key">[${esc(key)}]</b> ${esc(label)}`;   // digit fallback
  return esc(label.slice(0, i))
       + `<b class="key">[${esc(label[i].toUpperCase())}]</b>`
       + esc(label.slice(i + 1));
}
function legendGroup(label, items, keys){
  const g = document.createElement('div');
  g.className = 'legend-group';
  g.innerHTML = `<b>${label}</b>` + items.map(([l, swatch, q], i) => {
    const key = keys[i];
    if (key) ACCEL.set(key, q);
    return `<span data-filter="${q}" title="Filter by ${q}${key ? ` — key ${key}` : ''}">${swatch}${accelHtml(l, key)}</span>`;
  }).join('');
  legend.appendChild(g);
}

const TYPE_ITEMS = Object.keys(TYPE_FILL).concat(['(untyped)']).map(t =>
  [t, `<i style="background:${t === '(untyped)' ? NO_TYPE_FILL : TYPE_FILL[t]}"></i>`,
   t === '(untyped)' ? '@untyped' : '@' + norm(t)]);
const STATUS_ITEMS = Object.keys(STATUS_RING).concat(['active']).map(k => {
  const r = STATUS_RING[k];
  const style = r ? `border-color:${r.c};${r.dash ? 'border-style:dashed;' : ''}` : 'border-color:var(--line)';
  return [k, `<i class="ring" style="${style}"></i>`, '@' + norm(k)];
});
// Matched across both rows at once, not per row.
const ALL_KEYS = assignAccels(
  TYPE_ITEMS.concat(STATUS_ITEMS).map(i => i[0]),
  TYPE_ITEMS.map(() => 3).concat(STATUS_ITEMS.map(() => 1)));
legendGroup('type', TYPE_ITEMS, ALL_KEYS.slice(0, TYPE_ITEMS.length));
legendGroup('status', STATUS_ITEMS, ALL_KEYS.slice(TYPE_ITEMS.length));

const svg = d3.select('svg'), view = d3.select('#view');
const stage = document.getElementById('stage');
const W = () => stage.clientWidth, H = () => stage.clientHeight;
const nodes = DATA.nodes.map(n => ({...n, id:n.path, degree:0}));
const links = DATA.links.filter(l => byPath.has(l.source) && byPath.has(l.target)).map(l => ({...l}));
links.forEach(l => { const s=nodes.find(n=>n.id===l.source), t=nodes.find(n=>n.id===l.target); if(s) s.degree++; if(t) t.degree++; });
const radius = n => 6 + Math.min(10, n.degree * 1.4);

const sim = d3.forceSimulation(nodes)
  .force('link', d3.forceLink(links).id(d=>d.id).distance(90).strength(.6))
  .force('charge', d3.forceManyBody().strength(-260))
  .force('collide', d3.forceCollide().radius(n => radius(n) + 26))
  .force('center', d3.forceCenter(W()/2, H()/2))
  .force('x', d3.forceX(W()/2).strength(.03)).force('y', d3.forceY(H()/2).strength(.03));

// forceLink rewrites link endpoints from ids to node objects once it runs, so
// anything reading them has to cope with both.
const lid = v => (v && typeof v === 'object') ? v.id : v;

const linkG = view.append('g'), nodeG = view.append('g');
let link = linkG.selectAll('path'), node = nodeG.selectAll('g');

// Nodes and links are joined on every view change rather than once at startup,
// because focus mode removes nodes from the simulation so the remaining
// subgraph can lay itself out instead of sitting in the holes the hidden ones
// left behind.
function render(visNodes, visLinks){
  link = linkG.selectAll('path')
    .data(visLinks, d => lid(d.source) + '>' + lid(d.target))
    .join('path').attr('class', 'link');

  node = nodeG.selectAll('g')
    .data(visNodes, d => d.id)
    .join(enter => {
      const g = enter.append('g').attr('class', 'node')
        .call(d3.drag()
          .on('start', (e,d) => { if(!e.active) sim.alphaTarget(.3).restart(); d.fx=d.x; d.fy=d.y; })
          .on('drag',  (e,d) => { d.fx=e.x; d.fy=e.y; })
          .on('end',   (e,d) => { if(!e.active) sim.alphaTarget(0); }))
        .on('click', (e,d) => { e.stopPropagation(); select(d); });
      // The status ring must be set with .style(), not .attr(). An SVG stroke
      // set via .attr() is a presentation attribute, and ANY css rule beats a
      // presentation attribute — so `.node circle{stroke:var(--bg)}` was
      // painting every ring the background colour and the rings were
      // invisible. An inline style outranks the stylesheet; .selected keeps
      // !important so it still wins.
      g.append('circle')
        .attr('r', radius)
        .attr('fill', fillOf)
        .style('stroke', n => { const r = ringOf(n); return r ? r.c : null; })
        .style('stroke-width', n => ringOf(n) ? '2.5px' : null)
        .style('stroke-dasharray', n => { const r = ringOf(n); return r && r.dash ? r.dash : null; });
      g.append('title').text(n => {
        const t = (n.meta && n.meta.title || '').trim();
        return t ? `${t}\n${n.path}` : n.path;
      });
      g.append('text').attr('dy', n => radius(n) + 11).attr('text-anchor','middle').text(titleOf);
      return g;
    });

  sim.nodes(visNodes);
  sim.force('link').links(visLinks);
  sim.alpha(.6).restart();
}

// Which nodes the view shows. Without focus that is everything; with focus and
// an active filter it is the matches, optionally widened by one hop so a
// filtered set arrives with the documents it cites.
let focusMode = false, includeLinked = false;
function applyView(){
  let visNodes = nodes, visLinks = links;
  if (focusMode && matchSet && matchSet.size) {
    const keep = new Set(matchSet);
    if (includeLinked) links.forEach(l => {
      const a = lid(l.source), b = lid(l.target);
      if (matchSet.has(a)) keep.add(b);
      if (matchSet.has(b)) keep.add(a);
    });
    visNodes = nodes.filter(n => keep.has(n.id));
    visLinks = links.filter(l => keep.has(lid(l.source)) && keep.has(lid(l.target)));
  }
  render(visNodes, visLinks);
  applyDim();
}

sim.on('tick', () => {
  link.attr('d', d => `M${d.source.x},${d.source.y}L${d.target.x},${d.target.y}`);
  node.attr('transform', d => `translate(${d.x},${d.y})`);
});
const zoom = d3.zoom().scaleExtent([.15, 6]).on('zoom', e => view.attr('transform', e.transform));
svg.call(zoom).on('dblclick.zoom', null).on('dblclick', () => svg.transition().duration(350).call(zoom.transform, d3.zoomIdentity));
svg.on('click', () => { clearSelection(); });

let selected = null;
// The active filter's matching node ids, or null when no filter is set. Dim
// state is a function of BOTH this and the selection, so neither clobbers the
// other — clicking a node used to overwrite .dim and wipe out the filter.
let matchSet = null;
function neighbours(d){ const s=new Set([d.id]); links.forEach(l=>{ if(lid(l.source)===d.id) s.add(lid(l.target)); if(lid(l.target)===d.id) s.add(lid(l.source)); }); return s; }
// Single source of truth for dimming. A filter, once set, owns which nodes are
// dim; a selection then only adds the ring and narrows the links. With no
// filter, selection dims to the neighbourhood as before.
function applyDim(){
  const nb = selected ? neighbours(selected) : null;
  node.classed('selected', n => selected ? n.id === selected.id : false);
  node.classed('dim', n => {
    // In focus mode non-matching nodes are gone, so dim reverts to showing the
    // selection's neighbourhood within whatever is on screen.
    if (matchSet && !focusMode) return !matchSet.has(n.id);
    return nb ? !nb.has(n.id) : false;
  });
  link.classed('dim', l => {
    if (selected) return lid(l.source) !== selected.id && lid(l.target) !== selected.id;
    if (matchSet && !focusMode) return !(matchSet.has(lid(l.source)) && matchSet.has(lid(l.target)));
    return false;
  });
}
function select(d){ selected = d; applyDim(); openPanel(d); }
function clearSelection(){ selected = null; closePanel(); applyDim(); }

const panel = document.getElementById('panel'), panelTop = panel.querySelector('.top'), body = panel.querySelector('.body');
panel.querySelector('.close').onclick = clearSelection;
const linkify = v => /^https?:\/\//.test(v) ? `<a href="${esc(v)}" target="_blank" rel="noopener">${esc(v.replace(/^https?:\/\/github\.com\//,''))}</a>` : esc(v);
// Resolve a relative markdown href against a node's own directory.
function resolve(fromPath, href){
  if (!href || /^https?:/.test(href) || href.startsWith('#')) return null;
  const base = fromPath.split('/').slice(0,-1).join('/');
  const stack = [];
  ((base ? base + '/' : '') + href.split('#')[0]).split('/').forEach(p => {
    if (p === '..') stack.pop(); else if (p && p !== '.') stack.push(p);
  });
  const t = stack.join('/');
  return byPath.get(t) || byPath.get(t + '.md') || null;
}
function goTo(path){
  const n = nodes.find(x => x.id === path);
  if (!n) return;
  select(n);
  svg.transition().duration(400).call(zoom.transform, d3.zoomIdentity.translate(W()/2 - n.x, H()/2 - n.y));
}
// A frontmatter value that names a file in the graph becomes a link into it,
// labelled by the target's title rather than its path.
function metaLink(fromPath, v){
  const hit = resolve(fromPath, String(v));
  if (hit) {
    const label = (hit.meta && hit.meta.title) || hit.path.split('/').pop();
    return `<a href="#" class="internal" data-goto="${esc(hit.path)}" title="${esc(hit.path)}">${esc(label)}</a>`;
  }
  return linkify(String(v));
}
function openPanel(d){
  const m = d.meta || {};
  const chips = [];
  if (m.status) chips.push(`<span class="chip status chip--filter" data-filter="@${esc(norm(m.status))}" title="Filter by @${esc(norm(m.status))}" style="background:${colorOf(d)}"><b>${esc(m.status)}</b></span>`);
  if (m.type) chips.push(`<span class="chip chip--filter" data-filter="@${esc(norm(m.type))}" title="Filter by @${esc(norm(m.type))}">type <b>${esc(m.type)}</b></span>`);
  if (m.initiative) chips.push(`<span class="chip">initiative <b>${esc(m.initiative)}</b></span>`);
  if (m.claimed_by) chips.push(`<span class="chip">claimed by <b>${esc(m.claimed_by)}</b></span>`);
  (Array.isArray(m.tags)?m.tags:[]).forEach(t => chips.push(`<span class="chip chip--tag" data-tag="${esc(t)}" title="Filter by #${esc(t)}">#${esc(t)}</span>`));
  const rows = [];
  const show = (k,v) => rows.push(`<dt>${esc(k)}</dt><dd>${v}</dd>`);
  if (m.description) show('description', esc(m.description));
  if (m.timestamp) show('timestamp', esc(m.timestamp));
  if (m.claimed_at) show('claimed at', esc(m.claimed_at));
  if (m.repos) show('repos', esc(Array.isArray(m.repos)?m.repos.join(', '):m.repos));
  if (m.blocked_by && m.blocked_by.length) show('blocked by', (Array.isArray(m.blocked_by)?m.blocked_by:[m.blocked_by]).map(v=>metaLink(d.path,v)).join('<br>'));
  if (m.spec) show('spec', (Array.isArray(m.spec)?m.spec:[m.spec]).map(v=>metaLink(d.path,v)).join('<br>'));
  if (m.resource) show('resource', metaLink(d.path, m.resource));
  if (m.superseded_by) show('superseded by', metaLink(d.path, m.superseded_by));
  if (m.pr) show('pr', (Array.isArray(m.pr)?m.pr:[m.pr]).map(linkify).join('<br>'));
  if (m.wontfix) show('wontfix', 'yes');
  show('modified', esc(d.mtime.replace('T',' ').slice(0,16)+' UTC'));
  const outs = links.filter(l=>l.source.id===d.id).map(l=>l.target.id).sort();
  const inns = links.filter(l=>l.target.id===d.id).map(l=>l.source.id).sort();
  // Each link carries the same two channels the nodes do: a dot filled by
  // **type** and, for a task, a chip coloured by **status**. Reusing `fillOf`
  // and `STATUS_RING` rather than picking fresh colours is the whole point —
  // a second palette meaning the same things is how a legend stops being true.
  //
  // The status chip is on tasks only. Everything else is `active` or has no
  // status at all, and a row of chips all saying the same word is noise that
  // makes the one that differs harder to see.
  const linkList = paths => paths.map(pth => {
    const n = byPath.get(pth);
    const meta = (n && n.meta) || {};
    const label = meta.title || pth.split('/').pop();
    const type = meta.type || 'untyped';
    const dot = `<i class="ldot" style="background:${n ? fillOf(n) : NO_TYPE_FILL}" title="${esc(type)}"></i>`;
    const ring = n ? ringOf(n) : null;
    const chip = (type === 'task' && meta.status)
      ? ` <em class="lstatus" style="color:${ring ? ring.c : '#94a3b8'};border-color:${ring ? ring.c : '#94a3b8'}">${esc(meta.status)}</em>`
      : '';
    return `<li>${dot}<a href="#" class="internal" data-goto="${esc(pth)}" title="${esc(pth)}">${esc(label)}</a>${chip}</li>`;
  }).join('');
  // Counts alone can be read but not followed, so each is a disclosure that
  // lists the files. <details> keeps the open/closed state without any JS.
  const grp = (word, paths) => paths.length
    ? `<details class="linkgrp"><summary>${paths.length} ${word}</summary><ul>${linkList(paths)}</ul></details>`
    : `<span class="muted">0 ${word}</span>`;
  show('links', grp('out', outs) + grp('in', inns));
  panelTop.innerHTML = `<div class="path">${esc(d.path)}</div><h2>${esc(m.title || d.path.split('/').pop())}</h2><div class="chips">${chips.join('')}</div><dl class="kv">${rows.join('')}</dl>`;
  panelTop.querySelectorAll('a[data-goto]').forEach(a => {
    a.onclick = ev => { ev.preventDefault(); goTo(a.getAttribute('data-goto')); };
  });
  panelTop.querySelectorAll('[data-tag]').forEach(el => {
    el.onclick = () => { searchEl.value = '#' + el.getAttribute('data-tag'); applyFilter(); };
  });
  wireFilterables(panelTop);
  marked.setOptions({gfm:true, breaks:false});
  body.innerHTML = marked.parse(d.body || '');
  body.querySelectorAll('a[href]').forEach(a => {
    const href = a.getAttribute('href');
    if (/^https?:/.test(href)) { a.target='_blank'; a.rel='noopener'; return; }
    const hit = resolve(d.path, href);
    if (hit) { a.classList.add('internal'); a.href = '#'; a.onclick = ev => { ev.preventDefault(); goTo(hit.path); }; }
  });
  body.scrollTop = 0; panel.classList.add('open');
}
function closePanel(){ panel.classList.remove('open'); }

const searchEl = document.getElementById('search'), matchEl = document.getElementById('matches');
// A term beginning with "#" filters on frontmatter tags; a bare term matches
// path or title. Terms are ANDed, so "#ci #security" narrows rather than widens
// and "#ci polling" mixes the two.
function applyFilter(){
  const raw = searchEl.value.trim().toLowerCase();
  clearEl.hidden = !searchEl.value;
  if (!raw) {
    matchSet = null;
    matchEl.textContent = '';
    applyView();
    return;
  }
  const terms = raw.split(/\s+/);
  const tagTerms  = terms.filter(t => t.startsWith('#') && t.length > 1).map(t => t.slice(1));
  const kindTerms = terms.filter(t => t.startsWith('@') && t.length > 1).map(t => norm(t.slice(1)));
  const textTerms = terms.filter(t => !/^[#@]/.test(t) && t);
  matchSet = new Set();
  nodes.forEach(n => {
    const tags = (Array.isArray(n.meta.tags) ? n.meta.tags : []).map(t => String(t).toLowerCase());
    const tagsOk = tagTerms.every(q => tags.some(t => t.includes(q)));
    // @ matches either channel: a type or a status.
    const kinds = [norm(n.meta.type), norm(n.meta.status)].filter(Boolean);
    const kindOk = kindTerms.every(q =>
      q === 'untyped' ? !n.meta.type : kinds.some(k => k.includes(q)));
    const hay = (n.path + ' ' + (n.meta.title || '')).toLowerCase();
    const textOk = textTerms.every(q => hay.includes(q));
    if (tagsOk && kindOk && textOk) matchSet.add(n.id);
  });
  const hits = matchSet.size;
  matchEl.textContent = `${hits} hit${hits === 1 ? '' : 's'}`;
  applyView();
}
// Anything carrying data-filter sets the search box and runs the filter:
// legend entries, and the type/status chips in the panel.
function wireFilterables(root){
  root.querySelectorAll('[data-filter]').forEach(el => {
    el.onclick = () => { searchEl.value = el.getAttribute('data-filter'); applyFilter(); };
  });
}
wireFilterables(legend);
const focusEl = document.getElementById('focus'), linkedEl = document.getElementById('linked');
focusEl.onchange = () => { focusMode = focusEl.checked; linkedEl.disabled = !focusMode; applyView(); };
linkedEl.onchange = () => { includeLinked = linkedEl.checked; applyView(); };
const clearEl = document.getElementById('clear');
function clearSearch(){ searchEl.value = ''; applyFilter(); searchEl.focus(); }
clearEl.onclick = clearSearch;
searchEl.addEventListener('keydown', e => { if (e.key === 'Escape') clearSearch(); });
// A bracketed key applies that legend entry's filter; pressing it again clears
// it. Ignored while typing in a field, and never steals a browser shortcut.
document.addEventListener('keydown', e => {
  if (e.metaKey || e.ctrlKey || e.altKey) return;
  const t = e.target;
  if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
  if (e.key === 'Escape') { clearSearch(); return; }
  const q = ACCEL.get(e.key.toLowerCase());
  if (!q) return;
  e.preventDefault();
  searchEl.value = (searchEl.value.trim() === q) ? '' : q;
  applyFilter();
});
searchEl.addEventListener('input', applyFilter);
applyView();   // first paint
window.addEventListener('resize', () => { sim.force('center', d3.forceCenter(W()/2, H()/2)).alpha(.2).restart(); });
</script></body></html>'''

if __name__ == '__main__':
    sys.exit(main() or 0)
