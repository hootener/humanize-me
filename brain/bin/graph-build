#!/usr/bin/env python3
"""Build brain/graph.html: a browser-only graph of every markdown file in brain.

Nodes are files (titled by relative path), edges are markdown links between
them, colours follow the frontmatter `status`. Re-run after editing brain.
"""
import json
import os, re, sys
from datetime import datetime, timezone

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..'))
OUT = os.path.join(ROOT, 'graph.html')
# The page title: the project folder that holds brain/, so a template copy names itself.
NAME = os.path.basename(os.path.dirname(ROOT))
# `templates` holds the OKF files other documents are started from. They are
# valid markdown with real frontmatter, so they used to appear as nodes — a
# template task rendering as a Not Ready ticket. They are patterns, not
# knowledge, so they are not part of the graph. The linter still checks them.
SKIP_DIRS = {'bin', '.git', 'node_modules', 'templates', 'skills', 'example', 'handoff', 'feedback', 'docs', 'hooks'}

def parse_front(text):
    m = re.match(r'^---\n(.*?)\n---\n?', text, re.S)
    if not m:
        return {}, text
    fm, body = {}, text[m.end():]
    key = None
    for line in m.group(1).splitlines():
        if re.match(r'^\s+-\s', line) and key:          # yaml list item
            fm.setdefault(key, [])
            if isinstance(fm[key], list):
                fm[key].append(line.strip()[2:].strip().strip('"\''))
            continue
        if ':' not in line or line.startswith(' '):
            continue
        k, v = line.split(':', 1); key = k.strip(); v = v.strip()
        if v.startswith('[') and v.endswith(']'):
            v = [x.strip().strip('"\'') for x in v[1:-1].split(',') if x.strip()]
        elif v == '':
            v = []
        else:
            v = v.strip('"\'')
        fm[key] = v
    return fm, body

def collect():
    files = {}
    for dirpath, dirnames, filenames in os.walk(ROOT):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
        for f in filenames:
            if f.endswith('.md'):
                p = os.path.join(dirpath, f)
                rel = os.path.relpath(p, ROOT)
                text = open(p, encoding='utf-8').read()
                fm, body = parse_front(text)
                files[rel] = {'path': rel, 'meta': fm, 'body': body, 'raw': text,
                              'mtime': datetime.fromtimestamp(os.path.getmtime(p), timezone.utc).isoformat(timespec='seconds')}
    return files

LINK_RE = re.compile(r'\[[^\]]*\]\(([^)\s]+)\)|\[\[([^\]|]+)(?:\|[^\]]*)?\]\]')

def edges_for(rel, body, files, meta=None):
    out = set()
    base = os.path.dirname(rel)
    names = {os.path.splitext(os.path.basename(p))[0]: p for p in files}
    # Frontmatter paths (blocked_by, spec) are relative markdown links too.
    extra = []
    for k in ('blocked_by', 'spec'):
        v = (meta or {}).get(k)
        extra += v if isinstance(v, list) else ([v] if v else [])
    found = [(m.group(1) or m.group(2), bool(m.group(2))) for m in LINK_RE.finditer(body)] + [(e, False) for e in extra]
    for target, wiki in found:
        if not target or target.startswith(('http://', 'https://', 'mailto:', '#')):
            continue
        target = target.split('#')[0]
        if wiki:  # wikilink by name
            hit = names.get(target.strip())
            if hit: out.add(hit)
            continue
        cand = os.path.normpath(os.path.join(base, target))
        if cand in files:
            out.add(cand)
        elif cand + '.md' in files:
            out.add(cand + '.md')
    out.discard(rel)
    return sorted(out)

GENERATED = re.compile(r'"generated":\s*"[^"]*"')


def strip_generated(html):
    """The build stamp is the one byte that legitimately changes every run."""
    return GENERATED.sub('"generated": ""', html)


def main():
    files = collect()
    nodes, links = [], []
    for rel, f in sorted(files.items()):
        f['links'] = edges_for(rel, f['body'], files, f['meta'])
        nodes.append({k: f[k] for k in ('path', 'meta', 'body', 'mtime')})
        for t in f['links']:
            links.append({'source': rel, 'target': t})
    data = {'generated': datetime.now(timezone.utc).isoformat(timespec='seconds'), 'nodes': nodes, 'links': links}
    html = TEMPLATE.replace('__DATA__', json.dumps(data).replace('</', '<\\/'))
    html = html.replace('__BRAIN_NAME__', NAME)

    # `--check` answers "is the committed graph current?" without writing, which
    # is what CI needs. A plain rebuild-and-diff cannot answer it: every build
    # stamps a fresh `generated` time, the whole payload sits on one line, and
    # git therefore reports the file as changed every single run. The check
    # would have failed on every commit forever while looking like a real
    # finding. So compare everything *except* the timestamp.
    if '--check' in sys.argv:
        if not os.path.exists(OUT):
            print('graph.html has never been built', file=sys.stderr)
            return 1
        current = open(OUT, encoding='utf-8').read()
        if strip_generated(current) == strip_generated(html):
            print(f'graph.html is current: {len(nodes)} nodes, {len(links)} edges')
            return 0
        print('graph.html is out of date — run `bin/graph-build` and commit it',
              file=sys.stderr)
        return 1

    open(OUT, 'w', encoding='utf-8').write(html)
    print(f'wrote {os.path.relpath(OUT)}: {len(nodes)} nodes, {len(links)} edges')
    return 0

