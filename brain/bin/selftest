#!/usr/bin/env python3
"""Check that a fresh install works and that the tools survive foreign content.

Usage: brain/bin/selftest [-v]
Exit 1 on any failure. Writes nothing outside a temporary directory.

## Why this exists

Every defect this brain has fixed was found by adopting it into somebody
else's project. **None was found by its own checks**, and the reason is
structural: the template passes its own linter by construction, because the
same hand wrote both. Three adoptions found a dozen bugs; the test suite
found none, because there was no test suite.

Two layers, and the second is the point.

**The install test** is a smoke test. It would have caught two real bugs
mechanically: a documented install path that left the host tracking a gitlink
instead of eighty files, and a first install that greeted its adopter with
seventeen dangling links.

**The fixture** is a small corpus deliberately *not* written for this brain —
a decision with no frontmatter, a status in prose, a citation in backticks, a
running record whose entries postdate it. Every case in it is something a real
project actually did. Keeping a sample permanently is the cheapest way to stop
relying on the next adoption to notice.

## What it cannot do

It locks in what three adoptions taught us. It will not find the *next* class
of design bug, because nobody has thought of that one yet. A green run here is
not evidence that the brain is ready for a project it has never met; only
meeting one is.
"""
import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..'))

passed, failed = [], []


def check(name, ok, detail=''):
    (passed if ok else failed).append(name)
    mark = ' ok ' if ok else 'FAIL'
    print(f'  [{mark}] {name}' + (f'\n         {detail}' if detail and not ok else ''))
    return ok


def run(args, cwd):
    p = subprocess.run(args, cwd=cwd, capture_output=True, text=True)
    return p.returncode, p.stdout + p.stderr


# ----------------------------------------------------------------- the install

def install(tmp, verbose):
    """A fresh adopt into a throwaway host must be silent."""
    host = os.path.join(tmp, 'host')
    os.makedirs(host)
    subprocess.run(['git', 'init', '-q', host], capture_output=True)
    open(os.path.join(host, 'README.md'), 'w').write('# host\n')
    subprocess.run(['git', 'add', '-A'], cwd=host, capture_output=True)
    subprocess.run(['git', '-c', 'user.email=t@t', '-c', 'user.name=t',
                    'commit', '-qm', 'init'], cwd=host, capture_output=True)

    brain = os.path.join(host, 'brain')
    shutil.copytree(ROOT, brain, ignore=shutil.ignore_patterns('.git'))

    code, out = run([os.path.join(brain, 'bin', 'adopt')], brain)
    if verbose:
        print(out)
    check('adopt exits clean', code == 0, out[-300:])

    # The source is whatever brain this is run from, which for an adopter is
    # *their* brain with their content in it. Asserting zero warnings there
    # meant that following /brain-init correctly — which mandates `status:
    # draft` on every import, and lint warns on drafts — turned their build
    # red. A correct install of a brain with drafts in it has warnings.
    #
    # So: errors are never acceptable, and warnings are measured against the
    # source rather than against zero.
    _, base = run([os.path.join(ROOT, 'bin', 'lint')], ROOT)
    baseline = int(re.search(r'(\d+) warnings', base).group(1)) if 'warnings' in base else 0

    code, out = run([os.path.join(brain, 'bin', 'lint')], brain)
    errs = int(re.search(r'(\d+) errors', out).group(1)) if 'errors' in out else -1
    warns = int(re.search(r'(\d+) warnings', out).group(1)) if 'warnings' in out else -1
    check('lint reports no errors on a fresh install', errs == 0, out.strip()[-220:])
    check('the install adds no warnings of its own',
          warns <= baseline, f'{warns} warnings against a source baseline of {baseline}')

    for tool in ('doctor', 'stale'):
        code, out = run([os.path.join(brain, 'bin', tool)], brain)
        check(f'{tool} is clean on a fresh install', code == 0, out.strip()[-220:])

    code, out = run([os.path.join(brain, 'bin', 'graph-build'), '--check'], brain)
    check('committed graph matches a fresh build', code == 0, out.strip())

    # Keeping example/ reserves the ids it holds. The template's own record is
    # relocated, not deleted, and those ids are still in the tree — so issuing
    # them again would put two D0001s in one brain, which both the README and
    # CLAUDE.md promise cannot happen. An adopter who wants D0001 uses --bare.
    for kind, floor in (('goal', 'G0001'), ('decision', 'D0009'), ('task', 'T0009')):
        code, out = run([os.path.join(brain, 'bin', 'new'), '--next', kind], brain)
        got = out.strip()
        check(f'{kind} numbering clears what example/ holds',
              got > floor or (kind == 'goal' and got >= floor), f'got {got}, want > {floor}')

    # And a bare install, which keeps no example, starts at 1.
    bare = os.path.join(os.path.dirname(brain), 'bare')
    shutil.copytree(ROOT, bare, ignore=shutil.ignore_patterns('.git'))
    run([os.path.join(bare, 'bin', 'adopt'), '--sibling', '--bare'], bare)
    for kind, want in (('goal', 'G0001'), ('decision', 'D0001'), ('task', 'T0001')):
        _, out = run([os.path.join(bare, 'bin', 'new'), '--next', kind], bare)
        check(f'--bare starts {kind} numbering at {want}', out.strip() == want, out.strip())
    shutil.rmtree(bare, ignore_errors=True)

    link = os.path.join(host, '.claude', 'skills')
    check('skills are discoverable from the host root',
          os.path.isdir(link) and len(os.listdir(link)) > 5)
    check('skills resolve into the brain',
          os.path.realpath(link) == os.path.realpath(os.path.join(brain, 'skills')),
          f'{os.path.realpath(link)} != {os.path.realpath(os.path.join(brain, "skills"))}')

    # Nothing of ours in the host beyond the two things adopt announces.
    added = set(os.listdir(host)) - {'.git', 'README.md'}
    check('nothing written into the host but brain/ and .claude/',
          added == {'brain', '.claude'}, f'also found: {sorted(added - {"brain", ".claude"})}')
    check('the commit hook is installed',
          os.path.exists(os.path.join(host, '.git', 'hooks', 'post-commit')))

    # The install path that was documented wrongly for a year of this project's
    # life: a clone leaves a .git inside the brain and the host tracks a
    # gitlink — one entry instead of every file.
    check('the brain carries no .git of its own', not os.path.isdir(os.path.join(brain, '.git')))

    # The collision the first greenfield adopter hit: example/ held D0001 and
    # bin/new issued D0001, in a brain whose own documentation says ids are
    # flat and global.
    seen, dupes = {}, []
    for base, dirs, files in os.walk(brain):
        dirs[:] = [d for d in dirs if d not in {'.git', 'bin', 'templates', 'docs'}]
        for f in files:
            m = re.match(r'^([GDPSTE]\d{4})-', f)
            if m:
                dupes.append(m.group(1)) if m.group(1) in seen else seen.setdefault(m.group(1), f)
    check('no id is used twice, example/ included', not dupes, f'duplicates: {sorted(set(dupes))}')

    # The data-loss path: adopt's own first-run output says "re-run with
    # --with-ci", and the second run once swept the operator's own nodes into
    # example/ — identified by position, which is where brain-init puts them.
    # Every gate reported green afterwards.
    run([os.path.join(brain, 'bin', 'new'), 'decision', 'Operator node'], brain)
    before = sorted(os.listdir(os.path.join(brain, 'knowledge-catalog', 'decisions')))
    run([os.path.join(brain, 'bin', 'adopt'), '--with-ci'], brain)
    after = sorted(os.listdir(os.path.join(brain, 'knowledge-catalog', 'decisions')))
    check('a second adopt leaves the operator\'s own nodes alone',
          before == after, f'lost: {sorted(set(before) - set(after))}')
    check('doctor rejects a stray node in example/',
          _stray_is_caught(brain))

    return brain


def _stray_is_caught(brain):
    """Plant a node in example/ and confirm doctor refuses it."""
    planted = os.path.join(brain, 'example', 'knowledge-catalog', 'decisions',
                           'D9999-planted.md')
    os.makedirs(os.path.dirname(planted), exist_ok=True)
    open(planted, 'w').write('---\nid: D9999\ntype: decision\ntitle: "x"\n---\n')
    code, out = run([os.path.join(brain, 'bin', 'doctor')], brain)
    os.remove(planted)
    return code != 0 and 'never put' in out


# ------------------------------------------------------------------ the fixture

# Content written for some other system. Every case here is something a real
# project actually did, and the expectation is what the tools were designed to
# do about it. `want` strings must appear in lint's output; `absent` must not.
FIXTURE = [
    {
        'name': 'a decision with no frontmatter is an error',
        'why': 'imported ADRs arrive as bare prose',
        'path': 'knowledge-catalog/decisions/D0100-bare.md',
        'body': '# A choice\n\nWe chose the thing.\n',
        'want': ['no frontmatter'],
    },
    {
        'name': 'an unquoted colon in a title is an error',
        'why': 'nine real titles carried one; YAML truncates or throws',
        'path': 'knowledge-catalog/decisions/D0101-colon.md',
        'body': ('---\nid: D0101\ntype: decision\ntitle: Scope: what we cut\n'
                 'description: "x"\ntimestamp: "2026-01-01"\ntags: []\nstatus: draft\n---\n\n'
                 '# Context\nx\n# Decision\nx\n# Alternatives\nx\n# Consequences\nx\n'),
        'want': ['contains ": " unquoted'],
    },
    {
        'name': 'an imported draft is exempt from required headings',
        'why': '21 real decisions carried none of this brain\'s section names',
        'path': 'knowledge-catalog/decisions/D0102-draft.md',
        'body': ('---\nid: D0102\ntype: decision\ntitle: "Imported"\n'
                 'description: "x"\ntimestamp: "2026-01-01"\ntags: []\nstatus: draft\n---\n\n'
                 '# Whatever shape the other project used\n\nProse.\n'),
        'absent': ['D0102-draft.md: `decision` is missing'],
    },
    {
        'name': 'a promoted decision must carry its headings',
        'why': 'the exemption ends when a human vouches for the node',
        'path': 'knowledge-catalog/decisions/D0103-active.md',
        'body': ('---\nid: D0103\ntype: decision\ntitle: "Promoted"\n'
                 'description: "x"\ntimestamp: "2026-01-01"\ntags: []\nstatus: active\n---\n\n'
                 '# Whatever shape the other project used\n\nProse.\n'),
        'want': ['is missing the `# Context` section'],
    },
    {
        'name': 'a duplicate id is an error',
        'why': 'git merges two D0014s cleanly when the slugs differ',
        'path': 'knowledge-catalog/decisions/D0102-again.md',
        'body': ('---\nid: D0102\ntype: decision\ntitle: "Clash"\n'
                 'description: "x"\ntimestamp: "2026-01-01"\ntags: []\nstatus: draft\n---\n\nx\n'),
        'want': ['duplicate id `D0102`'],
    },
    {
        'name': 'an id that disagrees with its filename is an error',
        'why': 'a rename would otherwise orphan the node',
        'path': 'knowledge-catalog/decisions/D0104-mismatch.md',
        'body': ('---\nid: D0105\ntype: decision\ntitle: "Mismatch"\n'
                 'description: "x"\ntimestamp: "2026-01-01"\ntags: []\nstatus: draft\n---\n\nx\n'),
        'want': ['filename does not start with its id'],
    },
    {
        'name': 'a status outside its type\'s vocabulary is an error',
        'why': 'real trackers write the reason into the status',
        'path': 'tasks/misc/T0100-prose-status.md',
        'body': ('---\nid: T0100\ntype: task\ntitle: "Prose status"\ndescription: "x"\n'
                 'status: Blocked — waiting on the client\ninitiative: misc\n'
                 'blocked_by: []\ntimestamp: "2026-01-01"\ntags: []\n---\n\n'
                 '# What to build\nx\n# Acceptance criteria\n- [ ] x\n# Out of scope\n- x\n# Log\n'),
        'want': ['is not one of'],
    },
    {
        'name': 'an unknown category is an error',
        'why': 'category is an enum, and question joined it deliberately',
        'path': 'tasks/misc/T0101-category.md',
        'body': ('---\nid: T0101\ntype: task\ntitle: "Bad category"\ndescription: "x"\n'
                 'status: Not Ready\ncategory: nonsense\ninitiative: misc\n'
                 'blocked_by: []\ntimestamp: "2026-01-01"\ntags: []\n---\n\n'
                 '# What to build\nx\n# Acceptance criteria\n- [ ] x\n# Out of scope\n- x\n# Log\n'),
        'want': ['category `nonsense` is not one of'],
    },
    {
        'name': 'a node cited in backticks is reported as a lost edge',
        'why': '174 real citations were invisible to every tool',
        'path': 'knowledge-catalog/reference/E0100-backtick.md',
        'body': ('---\nid: E0100\ntype: evidence\ntitle: "Backticked citation"\n'
                 'description: "x"\ntimestamp: "2026-01-01"\ntags: []\nstatus: draft\n---\n\n'
                 'Carries out `../decisions/D0102-draft.md`, which is a lost edge.\n'),
        'want': ['cites a node in backticks'],
    },
    {
        'name': 'a backticked citation of a node that does not exist is reported',
        'why': 'a dead citation in prose rots in silence',
        'path': 'knowledge-catalog/reference/E0101-dead.md',
        'body': ('---\nid: E0101\ntype: evidence\ntitle: "Dead citation"\n'
                 'description: "x"\ntimestamp: "2026-01-01"\ntags: []\nstatus: draft\n---\n\n'
                 'See `../decisions/D0999-nope.md` for the reasoning.\n'),
        'want': ['names a node that does not exist'],
    },
    {
        'name': 'a node citing one written later is reported',
        'why': 'a port that stamped the import date made every citation a violation',
        'path': 'knowledge-catalog/reference/E0102-early.md',
        'body': ('---\nid: E0102\ntype: evidence\ntitle: "Written first"\n'
                 'description: "x"\ntimestamp: "2020-01-01"\ntags: []\nstatus: draft\n---\n\n'
                 'Depends on [D0102](../decisions/D0102-draft.md).\n'),
        'want': ['which is newer'],
    },
    {
        'name': 'a running record may cite nodes newer than itself',
        'why': 'a log opened in July cites the November decisions it records',
        'path': 'knowledge-catalog/reference/E0103-log.md',
        'body': ('---\nid: E0103\ntype: evidence\ntitle: "A running record"\n'
                 'description: "x"\ntimestamp: "2020-01-01"\ntags: []\nstatus: draft\n'
                 'append_only: true\n---\n\n'
                 'Records [D0102](../decisions/D0102-draft.md).\n'),
        'absent': ['E0103-log.md ('],
    },
]


def fixture(brain, verbose):
    """Write foreign content into a copy of the brain and check the reaction."""
    for case in FIXTURE:
        path = os.path.join(brain, case['path'])
        os.makedirs(os.path.dirname(path), exist_ok=True)
        open(path, 'w', encoding='utf-8').write(case['body'])

    _, out = run([os.path.join(brain, 'bin', 'lint')], brain)
    if verbose:
        print(out)

    for case in FIXTURE:
        ok = all(w in out for w in case.get('want', []))
        ok = ok and not any(a in out for a in case.get('absent', []))
        missing = [w for w in case.get('want', []) if w not in out]
        seen = [a for a in case.get('absent', []) if a in out]
        check(case['name'], ok,
              (f'expected but absent: {missing}' if missing else '')
              + (f'  present but should not be: {seen}' if seen else ''))

    # bin/relink converts the resolvable citation and leaves the dead one.
    _, out = run([os.path.join(brain, 'bin', 'relink')], brain)
    e100 = open(os.path.join(brain, 'knowledge-catalog/reference/E0100-backtick.md')).read()
    e101 = open(os.path.join(brain, 'knowledge-catalog/reference/E0101-dead.md')).read()
    check('relink converts a resolvable citation into a link', '](../decisions/D0102-draft.md)' in e100)
    check('relink leaves a dead citation alone', '`../decisions/D0999-nope.md`' in e101)

    # A plan blocker holds a task off the frontier.
    os.makedirs(os.path.join(brain, 'plans', 'probe'), exist_ok=True)
    open(os.path.join(brain, 'plans/probe/P0100-probe.md'), 'w').write(
        '---\nid: P0100\ntype: plan\ntitle: "Probe"\ndescription: "x"\n'
        'initiative: probe\ntimestamp: "2026-01-01"\ntags: []\nstatus: active\n'
        'serves: ../../knowledge-catalog/goals/index.md\n---\n\n'
        '# Goal\nx\n# Approach\nx\n# Sequence\n1. x\n# Risks\n- x\n')
    open(os.path.join(brain, 'tasks/misc/T0102-planblocked.md'), 'w').write(
        '---\nid: T0102\ntype: task\ntitle: "Blocked on an initiative"\ndescription: "x"\n'
        'status: Ready for Development\ncategory: question\ninitiative: misc\n'
        'blocked_by: [../../plans/probe/P0100-probe.md]\ntimestamp: "2026-01-01"\ntags: []\n---\n\n'
        '# What to build\nx\n# Acceptance criteria\n- [ ] x\n# Out of scope\n- x\n# Log\n')
    _, out = run([os.path.join(brain, 'bin', 'status'), 'misc'], brain)
    check('a plan with no finished tasks blocks a dependent task',
          'T0102' not in out.split('frontier')[-1], out.split('frontier')[-1].strip()[:160])
    check('the blocker column names the initiative', 'plan:probe' in out, out[-200:])


def regressions(brain, verbose):
    """One check per finding that changed code.

    The fixture above is a corpus of foreign content, written before any real
    adopter saw this. These are different: each locks a specific defect a cold
    adoption reported, so the fix cannot be undone by a later one. Four rounds
    of feedback produced roughly twenty code changes and five checks, which is
    why the same classes kept coming back — a parser bug, a laundering path and
    an install recipe each broke twice.

    **A fix lands with its check.** Anything here names the round it came from.
    """
    B = lambda *a: os.path.join(brain, *a)

    # R3 — a key with no inline value opens a block sequence; five tools set it
    # to '' and silently dropped every item, so `constrains:` governed nothing.
    open(B('knowledge-catalog', 'decisions', 'D0100-block-seq.md'), 'w').write(
        '---\nid: D0100\ntype: decision\ntitle: "Block sequence"\n'
        'description: "x"\ntimestamp: "2026-01-01"\ntags: []\nstatus: draft\n'
        'constrains:\n  - app/pricing\n  - app/billing\n---\n\n# Context\nx\n')
    _, out = run([B('bin', 'constraints'), 'app/pricing/Rate.php'], brain)
    check('R3 · a block-sequence `constrains:` actually governs',
          'D0100' in out, out.strip()[:200])

    # R2 — the excerpt came from # Context, where a decision states the position
    # it rejects, so the evidence argued against the decision it came from.
    open(B('knowledge-catalog', 'decisions', 'D0101-quote.md'), 'w').write(
        '---\nid: D0101\ntype: decision\ntitle: "Quoting probe"\n'
        'description: "x"\ntimestamp: "2026-01-01"\ntags: []\nstatus: draft\n---\n\n'
        '# Context\nA sprocket library could plausibly cover both cases.\n\n'
        '# Decision\nA sprocket library covers one case and never the other.\n')
    _, out = run([B('bin', 'relevant'), 'sprocket library covering both'], brain)
    check('R2 · the quote comes from the claim, not from # Context',
          'could plausibly cover' not in out, out.strip()[:200])

    # R2 — /brain-init promised lint reported this; nothing did.
    _, out = run([B('bin', 'lint')], brain)
    check('R2 · lint reports the draft count', 'draft' in out, out.strip()[-200:])

    # R1 — placeholders reached the record past a green gate.
    run([B('bin', 'new'), 'evidence', 'Scaffold regression'], brain)
    _, out = run([B('bin', 'lint')], brain)
    check('R1 · an unfilled scaffold is an error',
          'still the scaffold text' in out, out.strip()[-200:])

    # R1 — nothing wrote an index while two documents promised something did.
    idx = open(B('knowledge-catalog', 'reference', 'index.md')).read()
    check('R1 · bin/new puts the node in its folder index',
          'Scaffold regression' in idx, idx[-200:])
    log = open(B('knowledge-catalog', 'log.md')).read()
    check('R1 · bin/new appends to the change log',
          'Scaffold regression' in log, log[:200])

    for f in ('D0100-block-seq.md', 'D0101-quote.md'):
        os.remove(B('knowledge-catalog', 'decisions', f))
    for f in os.listdir(B('knowledge-catalog', 'reference')):
        if 'scaffold-regression' in f:
            os.remove(B('knowledge-catalog', 'reference', f))

    # R2 — the forward walk called an initiative with nothing in it complete.
    # A distinct id: the foreign-content fixture leaves a P0100 behind, and
    # bin/ancestry rightly refuses to guess between two nodes sharing one.
    os.makedirs(B('plans', 'asked'), exist_ok=True)
    open(B('plans', 'asked', 'P0101-nothing-asked.md'), 'w').write(
        '---\nid: P0101\ntype: plan\ntitle: "Nothing asked"\ndescription: "x"\n'
        'initiative: asked\ntimestamp: "2026-01-01"\ntags: []\nstatus: active\n'
        'serves: ../../knowledge-catalog/goals/index.md\n---\n\n# Goal\nx\n')
    _, out = run([B('bin', 'ancestry'), 'P0101', '--forward'], brain)
    check('R2 · an intent nothing asked of is not reported complete',
          'not been asked for yet' in out, out.strip()[-200:])
    shutil.rmtree(B('plans', 'asked'), ignore_errors=True)

    # R4 — the update recipe copied directories only, so INIT.md never arrived
    # and an updated install had neither the skill nor the document.
    os.remove(B('INIT.md'))
    _, out = run([B('bin', 'update'), ROOT], brain)
    check('R4 · an update restores every generic file, INIT.md included',
          os.path.isfile(B('INIT.md')), out.strip()[-200:])

    # R3/R4 — a skill body in a user-role envelope published as the operator's.
    _, out = run([B('bin', 'utterances'), '--limit', '200'], brain)
    check('R3 · an injected skill body is not attributed to the operator',
          'Base directory for this skill' not in out, out.strip()[:200])

    # R4 — nothing recorded which upstream revision a brain was running, so
    # "did the update land" meant diffing two trees by hand.
    cfg = open(B('config.md')).read()
    check('R4 · the install records its upstream revision',
          re.search(r'^brain_revision: "\S+"', cfg, re.M) is not None,
          cfg[:200])
    _, out = run([B('bin', 'doctor')], brain)
    check('R4 · doctor prints the upstream revision', 'upstream:' in out, out[:200])

    # R4 — a `timestamp: "<YYYY-MM-DD>"` inside a skill's illustrative
    # frontmatter is the point of the example. Stamping it destroys what is
    # being shown; flagging it ends every check dirty.
    check('R4 · an illustrative placeholder in a skill is not flagged',
          'YYYY-MM-DD' not in out, out[-200:])

    # R4 — generic documents cited upstream decisions by bare id. After an
    # install those ids belong to the adopter, so the citation resolves — to
    # the wrong node, which is worse than dangling.
    bare = []
    for f in ('INIT.md', 'CLAUDE.md', 'README.md'):
        t = open(B(f)).read()
        bare += re.findall(r'\[[GDPSTE]\d{4}\]\([^)]*knowledge-catalog[^)]*\)', t)
    check('R4 · no generic document cites a node by bare id', not bare, str(bare[:2]))

    # R4 — an update re-copies the generic prose, which arrives citing
    # knowledge-catalog/; without a repoint those citations resolve wrongly.
    _, out = run([B('bin', 'adopt'), '--repoint-only'], brain)
    check('R4 · the example repoint can be re-run after an update',
          'repointed' in out, out[:200])

    run([B('bin', 'index')], brain)
    run([B('bin', 'graph-build')], brain)


def main():
    ap = argparse.ArgumentParser(description='Does a fresh install work, and do the tools survive foreign content?')
    ap.add_argument('-v', '--verbose', action='store_true')
    args = ap.parse_args()

    tmp = tempfile.mkdtemp(prefix='brain-selftest-')
    try:
        print('Install')
        brain = install(tmp, args.verbose)
        print('\nForeign content')
        fixture(brain, args.verbose)
        print('\nRegressions — one per finding that changed code')
        regressions(brain, args.verbose)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    print(f'\n  {len(passed)} passed, {len(failed)} failed')
    if failed:
        for f in failed:
            print(f'    failed: {f}')
        return 1
    print('  A green run locks in what three adoptions taught us. It is not')
    print('  evidence the brain is ready for a project it has never met.')
    return 0


if __name__ == '__main__':
    sys.exit(main())
