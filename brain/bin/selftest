#!/usr/bin/env python3
"""Check that a fresh install works and that the tools survive foreign content.

Usage: brain/bin/selftest [-v]
Exit 1 on any failure. Writes nothing outside a temporary directory.

## Why this exists

Every defect this brain has fixed was found by adopting it into somebody
else's project. **None was found by its own checks**, and the reason is
structural: the template passes its own linter by construction, because the
same hand wrote both. Three adoptions found a dozen bugs; the test suite
found none, because there was no test suite.

Two layers, and the second is the point.

**The install test** is a smoke test. It would have caught two real bugs
mechanically: a documented install path that left the host tracking a gitlink
instead of eighty files, and a first install that greeted its adopter with
seventeen dangling links.

**The fixture** is a small corpus deliberately *not* written for this brain —
a decision with no frontmatter, a status in prose, a citation in backticks, a
running record whose entries postdate it. Every case in it is something a real
project actually did. Keeping a sample permanently is the cheapest way to stop
relying on the next adoption to notice.

## What it cannot do

It locks in what three adoptions taught us. It will not find the *next* class
of design bug, because nobody has thought of that one yet. A green run here is
not evidence that the brain is ready for a project it has never met; only
meeting one is.
"""
import argparse
import ast
import os
import re
import shutil
import subprocess
import sys
import tempfile
import traceback

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..'))

passed, failed, skipped = [], [], []


def check(name, ok, detail=''):
    (passed if ok else failed).append(name)
    mark = ' ok ' if ok else 'FAIL'
    print(f'  [{mark}] {name}' + (f'\n         {detail}' if detail and not ok else ''))
    return ok


def skip(name, reason):
    """A correct assertion whose precondition is absent.

    Four checks need the template's own `example/` record, which an adopted
    brain legitimately does not have. Reported as failures, they made the
    suite permanently red — and SLM said exactly what that cost: *"I have
    watched five failures for two rounds and stopped reading them, which is
    precisely why a crash in the same block took a deliberate look to notice
    rather than announcing itself."* A permanently red suite is a stale note,
    which is D0001 applied to CI.

    The line that distinguishes the two cases: **skip when the precondition is
    absent, fail when the assertion is false.** Never reach for this to quiet
    a check that is genuinely failing.
    """
    skipped.append((name, reason))
    print(f'  [skip] {name}\n         {reason}')
    return False


def run(args, cwd):
    p = subprocess.run(args, cwd=cwd, capture_output=True, text=True)
    return p.returncode, p.stdout + p.stderr


# ----------------------------------------------------------------- the install

def install(tmp, verbose):
    """A fresh adopt into a throwaway host must be silent."""
    host = os.path.join(tmp, 'host')
    os.makedirs(host)
    subprocess.run(['git', 'init', '-q', host], capture_output=True)
    open(os.path.join(host, 'README.md'), 'w').write('# host\n')
    subprocess.run(['git', 'add', '-A'], cwd=host, capture_output=True)
    subprocess.run(['git', '-c', 'user.email=t@t', '-c', 'user.name=t',
                    'commit', '-qm', 'init'], cwd=host, capture_output=True)

    brain = os.path.join(host, 'brain')
    shutil.copytree(ROOT, brain, ignore=shutil.ignore_patterns('.git'))

    # Baseline measured *here*, in the throwaway host, before adopt runs.
    #
    # Measuring it against the real repository compared unlike things: an
    # embedded brain may carry a typed edge pointing outside itself — one real
    # brain has `resource: ../../../skills/voice-professional/SKILL.md` — which
    # resolves where it lives and cannot resolve in a host containing nothing
    # but the brain. That read as "the install added an error" when the
    # install had added nothing and the context had changed. Same shape as
    # every other host-dependence bug here: the fixture's own conditions
    # mistaken for the subject's behaviour.
    _, pre = run([os.path.join(brain, 'bin', 'lint')], brain)
    base_errs = int(re.search(r'(\d+) errors', pre).group(1)) if 'errors' in pre else 0
    baseline = int(re.search(r'(\d+) warnings', pre).group(1)) if 'warnings' in pre else 0

    code, out = run([os.path.join(brain, 'bin', 'adopt')], brain)
    if verbose:
        print(out)
    check('adopt exits clean', code == 0, out[-300:])

    # The source is whatever brain this is run from, which for an adopter is
    # *their* brain with their content in it. Asserting zero warnings there
    # meant that following /brain-init correctly — which mandates `status:
    # draft` on every import, and lint warns on drafts — turned their build
    # red. A correct install of a brain with drafts in it has warnings.
    #
    # So: errors are never acceptable, and warnings are measured against the
    # source rather than against zero.
    code, out = run([os.path.join(brain, 'bin', 'lint')], brain)
    errs = int(re.search(r'(\d+) errors', out).group(1)) if 'errors' in out else -1
    warns = int(re.search(r'(\d+) warnings', out).group(1)) if 'warnings' in out else -1
    # Against the source, not against zero. `install()` copies ROOT — the brain
    # running the suite — so asserting an absolute zero asserts that *the
    # adopter's own record is clean*, under a name about the install. A brain
    # with two unfilled scaffolds in its own nodes failed a check about
    # installation. The subject here is what the install adds, so that is what
    # is measured. Seventh instance of this, again inside install().
    check('the install adds no lint errors of its own',
          errs >= 0 and errs <= base_errs,
          f'{errs} after install, {base_errs} in the source: {out.strip()[-180:]}')
    check('the install adds no warnings of its own',
          warns <= baseline, f'{warns} warnings against a source baseline of {baseline}')

    for tool in ('doctor', 'stale'):
        if tool == 'stale':
            # Same correction: `stale` counts claims in the adopter's own
            # prose, so a false claim they already carried is not something
            # the install did. Compare to the source rather than to clean.
            src_code, _ = run([os.path.join(ROOT, 'bin', tool)], ROOT)
            code, out = run([os.path.join(brain, 'bin', tool)], brain)
            if src_code != 0:
                skip('stale is clean on a fresh install',
                     'the source brain already carries a stale claim, so this '
                     'install cannot be the cause')
            else:
                check('stale is clean on a fresh install', code == 0,
                      out.strip()[-220:])
            continue
        if tool == 'stale' and not has_example(brain):
            # `stale` counts decisions against the prose that claims a number,
            # and the generic prose's counts describe the template's record.
            skip('stale is clean on a fresh install', NO_EXAMPLE)
            continue
        code, out = run([os.path.join(brain, 'bin', tool)], brain)
        check(f'{tool} is clean on a fresh install', code == 0, out.strip()[-220:])

    code, out = run([os.path.join(brain, 'bin', 'graph-build'), '--check'], brain)
    check('committed graph matches a fresh build', code == 0, out.strip())

    # Keeping example/ reserves the ids it holds. The template's own record is
    # relocated, not deleted, and those ids are still in the tree — so issuing
    # them again would put two D0001s in one brain, which both the README and
    # CLAUDE.md promise cannot happen. An adopter who wants D0001 uses --bare.
    # The floor is whatever that type's highest id actually is, anywhere in the
    # tree. It used to be hardcoded — G0001, D0009, T0009 — which are facts
    # about *this* brain's example/, so an adopter whose example/ holds
    # different ids failed a check describing somebody else's corpus. Fifth
    # instance of the host-dependence bug, in the one function the guard for it
    # deliberately exempts.
    for kind, letter in (('goal', 'G'), ('decision', 'D'), ('task', 'T')):
        if not has_example(brain):
            skip(f'{kind} numbering clears what example/ holds', NO_EXAMPLE)
            continue
        highest = ''
        for base, dirs, files in os.walk(brain):
            dirs[:] = [d for d in dirs if d not in {'.git', 'bin', 'templates'}]
            for f in files:
                m = re.match(rf'^({letter}\d{{4}})-', f)
                if m and m.group(1) > highest:
                    highest = m.group(1)
        code, out = run([os.path.join(brain, 'bin', 'new'), '--next', kind], brain)
        got = out.strip()
        check(f'{kind} numbering clears what example/ holds',
              not highest or got > highest, f'got {got}, highest present {highest}')

    # And a bare install, which keeps no example, starts at 1.
    bare = os.path.join(os.path.dirname(brain), 'bare')
    shutil.copytree(ROOT, bare, ignore=shutil.ignore_patterns('.git'))
    run([os.path.join(bare, 'bin', 'adopt'), '--sibling', '--bare'], bare)
    # Measured against the source, not against 1. ROOT here is whatever brain
    # selftest was run from — for an adopter, theirs, with their nodes in it —
    # so asserting G0001 turned a populated brain's CI red for having content.
    for kind, letter in (('goal', 'G'), ('decision', 'D'), ('task', 'T')):
        if not has_example(brain):
            skip(f'--bare reclaims the ids example/ was holding ({kind})',
                 NO_EXAMPLE)
            continue
        _, out = run([os.path.join(bare, 'bin', 'new'), '--next', kind], bare)
        _, src_out = run([os.path.join(ROOT, 'bin', 'new'), '--next', kind], ROOT)
        check(f'--bare reclaims the ids example/ was holding ({kind})',
              out.strip() <= src_out.strip(),
              f'bare offers {out.strip()}, source offers {src_out.strip()}')
    shutil.rmtree(bare, ignore_errors=True)

    link = os.path.join(host, '.claude', 'skills')
    check('skills are discoverable from the host root',
          os.path.isdir(link) and len(os.listdir(link)) > 5)
    check('skills resolve into the brain',
          os.path.realpath(link) == os.path.realpath(os.path.join(brain, 'skills')),
          f'{os.path.realpath(link)} != {os.path.realpath(os.path.join(brain, "skills"))}')

    # Nothing of ours in the host beyond the two things adopt announces.
    added = set(os.listdir(host)) - {'.git', 'README.md'}
    check('nothing written into the host but brain/ and .claude/',
          added == {'brain', '.claude'}, f'also found: {sorted(added - {"brain", ".claude"})}')
    check('the commit hook is installed',
          os.path.exists(os.path.join(host, '.git', 'hooks', 'post-commit')))

    # The install path that was documented wrongly for a year of this project's
    # life: a clone leaves a .git inside the brain and the host tracks a
    # gitlink — one entry instead of every file.
    check('the brain carries no .git of its own', not os.path.isdir(os.path.join(brain, '.git')))

    # Ids are unique within the **live record**. `example/` is a separate
    # namespace, and this check used to deny that — "no id is used twice,
    # example/ included" — while `.template-record`, written by bin/index,
    # says "a brain that already holds its own D0001 keeps it". Coexistence is
    # the documented intent; the check called the documented intent a failure.
    #
    # It cost a third adopter five failures: a hand-numbered port four months
    # before the brain shipped `bin/new` left 14 ids overlapping example/'s,
    # none of them reachable or confusing, all of them unavoidable. Any
    # adopter with a pre-existing catalog would have seen the same, which
    # makes this the suite telling them their brain is broken for having
    # history.
    #
    # The real hazard — `bin/new` *issuing* an id example/ already holds — is
    # a separate check, and it is the numbering one below.
    def ids_under(root, skip):
        seen, dupes = {}, []
        for base, dirs, files in os.walk(root):
            dirs[:] = [d for d in dirs if d not in skip]
            for f in files:
                m = re.match(r'^([GDPSTE]\d{4})-', f)
                if m:
                    (dupes.append(m.group(1)) if m.group(1) in seen
                     else seen.setdefault(m.group(1), f))
        return seen, dupes

    live_skip = {'.git', 'bin', 'templates', 'docs', 'example'}
    live, dupes = ids_under(brain, live_skip)
    check('no id is used twice in the live record', not dupes,
          f'duplicates: {sorted(set(dupes))}')

    ex = os.path.join(brain, 'example')
    if os.path.isdir(ex):
        held, _ = ids_under(ex, {'.git', 'bin', 'templates', 'docs'})
        overlap = sorted(set(held) & set(live))
        if overlap:
            print(f'  [note] {len(overlap)} id(s) exist in both the live record '
                  f'and example/: ' + ', '.join(overlap[:6])
                  + ('…' if len(overlap) > 6 else ''))
            print('         Not a failure. example/ is a separate namespace — a '
                  'brain that')
            print('         already held its own D0001 keeps it, which is what '
                  '.template-record')
            print('         promises. Delete example/ when you no longer want '
                  'the worked example.')

    # The data-loss path: adopt's own first-run output says "re-run with
    # --with-ci", and the second run once swept the operator's own nodes into
    # example/ — identified by position, which is where brain-init puts them.
    # Every gate reported green afterwards.
    run([os.path.join(brain, 'bin', 'new'), 'decision', 'Operator node'], brain)
    before = sorted(os.listdir(os.path.join(brain, 'knowledge-catalog', 'decisions')))
    run([os.path.join(brain, 'bin', 'adopt'), '--with-ci'], brain)
    after = sorted(os.listdir(os.path.join(brain, 'knowledge-catalog', 'decisions')))
    check('a second adopt leaves the operator\'s own nodes alone',
          before == after, f'lost: {sorted(set(before) - set(after))}')
    if not has_example(brain):
        skip('doctor rejects a stray node in example/', NO_EXAMPLE)
    elif not has_manifest(brain):
        skip('doctor rejects a stray node in example/', NO_MANIFEST)
    else:
        check('doctor rejects a stray node in example/',
              _stray_is_caught(brain))

    return brain


def _stray_is_caught(brain):
    """Plant a node in example/ and confirm doctor refuses it."""
    planted = os.path.join(brain, 'example', 'knowledge-catalog', 'decisions',
                           'D9999-planted.md')
    os.makedirs(os.path.dirname(planted), exist_ok=True)
    open(planted, 'w').write('---\nid: D9999\ntype: decision\ntitle: "x"\n---\n')
    code, out = run([os.path.join(brain, 'bin', 'doctor')], brain)
    os.remove(planted)
    return code != 0 and 'never put' in out


# ------------------------------------------------------------------ the fixture

