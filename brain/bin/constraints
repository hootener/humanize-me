#!/usr/bin/env python3
"""Which decisions govern a set of paths.

Usage:
    brain/bin/constraints app/Services/Pricing.php app/Models/Quote.php
    git diff --name-only main | xargs brain/bin/constraints
    brain/bin/constraints --all          # every decision and what it governs
    brain/bin/constraints --json <paths>

Exit 0 always. No decision governing a change is an answer, not an error.

## Why this exists

`bin/relevant` searches the record by term and, knowing term matching misses
the decision that matters, prints **every decision on every call** as a
backstop. At seventeen decisions that is four lines. At eighty it is noise,
and noise is not read — so the backstop stops working exactly when the record
gets big enough to need one.

The fix is not a better search. It is for a decision to **declare what it
governs**, in `constrains:`, so the question "which decisions apply here"
becomes a lookup instead of a guess (D0005). A decision that has not declared
anything still appears under `--all`; it simply cannot be matched to a diff.

## Matching

`constrains:` holds path globs, directory prefixes, or bare concept words.
A path matches a glob by `fnmatch`, a prefix by `startswith`, and a concept if
the word appears in the path. Crude on purpose: the author of the decision
chose the words, so a near-miss is a signal to sharpen `constrains:` rather
than to build a cleverer matcher here.
"""
import argparse
import fnmatch
import json
import os
import re
import sys

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..'))
DECISIONS = os.path.join(ROOT, 'knowledge-catalog', 'decisions')


def frontmatter(text):
    """Flat YAML plus block lists — the same shape the other bin tools parse."""
    if not text.startswith('---'):
        return {}, text
    end = text.find('\n---', 3)
    if end == -1:
        return {}, text
    out, key = {}, None
    for line in text[3:end].split('\n'):
        if re.match(r'^\s+-\s', line) and key:
            out.setdefault(key, [])
            if isinstance(out[key], list):
                out[key].append(line.strip()[2:].strip().strip('"\''))
            continue
        if ':' not in line or line.startswith(' '):
            continue
        k, v = line.split(':', 1)
        key, v = k.strip(), v.strip()
        if v.startswith('[') and v.endswith(']'):
            out[key] = [x.strip().strip('"\'') for x in v[1:-1].split(',') if x.strip()]
        elif v == '':
        # A key with no inline value opens a block sequence. Setting it to ''
        # here made the `- item` lines below fall through `isinstance(..., list)`
        # and vanish — so `constrains:` written the way most people write it
        # governed nothing, past a green lint, silently switching off the
        # payoff the README is built around.
            out[key] = []
        else:
            out[key] = v.strip('"\'')
    return out, text[end + 4:]


def decisions():
    if not os.path.isdir(DECISIONS):
        return
    for name in sorted(os.listdir(DECISIONS)):
        if not name.endswith('.md') or name == 'index.md':
            continue
        meta, _ = frontmatter(open(os.path.join(DECISIONS, name), encoding='utf-8').read())
        if meta.get('type') not in ('decision', 'principle'):
            continue
        yield name, meta


def matches(pattern, path):
    pattern, path = pattern.strip().rstrip('/'), path.replace('\\', '/')
    if not pattern:
        return False
    if any(c in pattern for c in '*?['):
        return fnmatch.fnmatch(path, pattern) or fnmatch.fnmatch(path, f'*/{pattern}')
    if '/' in pattern or '.' in pattern:
        return path.startswith(pattern) or f'/{pattern}' in f'/{path}'
    # A bare word is a concept, matched against the path's own words.
    return pattern.lower() in re.split(r'[/_.\-]', path.lower())


def main():
    ap = argparse.ArgumentParser(description='Which decisions govern these paths.')
    ap.add_argument('paths', nargs='*')
    ap.add_argument('--all', action='store_true', help='every decision and what it governs')
    ap.add_argument('--json', action='store_true')
    args = ap.parse_args()

    found, undeclared = [], []

    for name, meta in decisions():
        governs = meta.get('constrains') or []
        if isinstance(governs, str):
            governs = [governs]

        hits = sorted({p for p in args.paths for g in governs if matches(g, p)})

        if args.all or hits:
            found.append({
                'id': meta.get('id', name.split('-')[0]),
                'title': meta.get('title') or name,
                'path': os.path.relpath(os.path.join(DECISIONS, name), os.path.dirname(ROOT)),
                'status': meta.get('status', ''),
                'invariant': meta.get('invariant', ''),
                'constrains': governs,
                'matched': hits,
            })
        elif not governs:
            undeclared.append(meta.get('id', name.split('-')[0]))

    if args.json:
        print(json.dumps({'paths': args.paths, 'decisions': found,
                          'undeclared': undeclared}, indent=2))
        return 0

    if not args.paths and not args.all:
        print('Give some paths, or --all.', file=sys.stderr)
        return 0

    if not found:
        print('No decision declares that it governs these paths.')
    for d in found:
        stale = '  ⚠ SUPERSEDED' if d['status'] in ('superseded', 'deprecated') else ''
        print(f"  {d['id']}  {d['title']}{stale}")
        print(f"      {d['path']}")
        if d['invariant']:
            print(f"      must hold: {d['invariant']}")
        if d['matched']:
            print(f"      matched:   {', '.join(d['matched'][:6])}"
                  + ('…' if len(d['matched']) > 6 else ''))
        print()

    if undeclared:
        # Not a failure. But a decision with no `constrains:` can never be
        # found by a change, which is the one moment it most needs to be.
        print(f"  {len(undeclared)} decision(s) declare no `constrains:` and so can")
        print(f"  never match a diff: {', '.join(undeclared)}")

    if found and args.paths:
        print()
        print('  A change that contradicts one of these needs a recorded exit:')
        print('  amend the decision, or proceed against it with the id in the')
        print("  task's `# Log`. Noting it and moving on is not one of them.")

    return 0


if __name__ == '__main__':
    sys.exit(main())
