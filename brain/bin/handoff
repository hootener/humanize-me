def render(initiative, discipline, blocks, ctx):
    # `excluded` is a scope disclaimer. It used to render before the authored
    # prose, which put "Not included" ahead of "The problem this solves" on an
    # executive page and buried the only section with a deadline in it at
    # position six of eight. It is the one generated section with no reason to
    # come before something a person wrote.
    order = [k for k in BLOCKS[discipline] if k != 'excluded']
    parts = [f'<section><h2>{html.escape(TITLES[k])}</h2>{blocks[k]}</section>'
             for k in order if blocks.get(k)]
    for heading, chunk in (blocks.get('_extra') or []):
        parts.append(f'<section><h2>{html.escape(heading)}</h2>{chunk}</section>')
    if 'excluded' in BLOCKS[discipline] and blocks.get('excluded'):
        parts.append(f'<section><h2>{html.escape(TITLES["excluded"])}</h2>'
                     f'{blocks["excluded"]}</section>')
    if blocks.get('appendix'):
        parts.append(f'<section><h2>Appendix</h2>{blocks["appendix"]}</section>')

    title = ctx['plan_meta'].get('title') or initiative.replace('-', ' ').title()
    # A plan is titled "<Thing> plan"; the handoff is about the thing itself.
    title = re.sub(r'\s+plan$', '', title, flags=re.I)
    return f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{html.escape(title, quote=False)}</title>
<style>{CSS}</style></head><body><div class="wrap">
<header>
<p class="eyebrow">Handoff &middot; {html.escape(discipline)}</p>
<h1>{html.escape(title, quote=False)}</h1>
<p class="sub">{html.escape(ctx['plan_meta'].get('description', ''), quote=False)}</p>
</header>
{''.join(parts)}
<footer>Generated {date.today().isoformat()} from the project record.
The parts that come from the record are rewritten on every build; the
walkthrough and anything written for a reader are not.</footer>
</div></body></html>
"""


def main():
    ap = argparse.ArgumentParser(description='Render a handoff for one initiative.')
    ap.add_argument('initiative', nargs='?')
    ap.add_argument('--for', dest='discipline', choices=sorted(BLOCKS))
    ap.add_argument('--plan', help='the plan this handoff is about, when the '
                                   'initiative holds more than one')
    ap.add_argument('--check', action='store_true', help='report readiness and stop')
    ap.add_argument('--list', action='store_true', help='initiatives and disciplines')
    args = ap.parse_args()

    if args.list or not args.initiative:
        print('disciplines: ' + ', '.join(sorted(BLOCKS)))
        print('initiatives:')
        for d in sorted(os.listdir(TASKS) if os.path.isdir(TASKS) else []):
            if os.path.isdir(os.path.join(TASKS, d)):
                print(f'  {d}')
        return 0

    ctx, blocking, notes = inspect(args.initiative, args.plan)

    for b in blocking:
        print(f'  BLOCKED  {b}', file=sys.stderr)
    for n in notes:
        print(f'  note     {n}')
    if blocking:
        print('\n  No handoff written. Nothing requires one — but one made from this '
              'would not be honest.', file=sys.stderr)
        return 1
    if args.check:
        print('\n  Ready to generate.')
        return 0
    if not args.discipline:
        print('  Give --for <discipline>: ' + ', '.join(sorted(BLOCKS)), file=sys.stderr)
        return 1

    authored_dir = os.path.join(os.path.dirname(ctx['plan_path']), 'handoff')
    authored_keys = set()
    blocks = build_blocks(ctx, args.initiative, args.discipline, authored_dir, authored_keys)

    missing = [k for k in BLOCKS[args.discipline]
               if k in AUTHORED_ONLY and not blocks.get(k)]
    if missing:
        src = os.path.join(authored_dir, f'{args.discipline}.md')
        rel = os.path.relpath(src, ROOT)
        where = (f'{rel} does not carry' if os.path.isfile(src)
                 else f'no authored half at {rel}, so nothing carries')
        print(f'  note     {where}: ' + ', '.join(TITLES[k] for k in missing))
        print('           omitted rather than left empty. The graph cannot write those '
              '— a screenshot\n           walkthrough, or a trap that cost somebody a '
              'day, has to come from a person.')

    if blocks.get('_extra'):
        print('  note     carried through verbatim, outside this discipline\'s '
              'sections: '
              + ', '.join(h for h, _ in blocks['_extra']))
        print('           They render after the generated ones, in the order you '
              'wrote them.')

    if args.discipline in OUTWARD:
        derived = [k for k in BLOCKS[args.discipline]
                   if k in ('excluded', 'open', 'outstanding')
                   and blocks.get(k) and k not in authored_keys]
        if derived:
            print('  note     ' + ', '.join(TITLES[k] for k in derived)
                  + ' came from the record, which was written for colleagues.')
            print('           Read it as a reader outside the project would; rewrite it '
                  'in the\n           authored half if it carries internal vocabulary.')

    out = os.path.join(os.path.dirname(ctx['plan_path']),
                       f'handoff-{args.discipline}.html')
    open(out, 'w', encoding='utf-8').write(render(args.initiative, args.discipline, blocks, ctx))
    print(f'\n  wrote {os.path.relpath(out, ROOT)}  '
          f'({len([k for k in BLOCKS[args.discipline] if blocks.get(k)]) + len(blocks.get('_extra') or [])} sections)')
    return 0


if __name__ == '__main__':
    sys.exit(main())
