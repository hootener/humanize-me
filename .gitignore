# macOS
.DS_Store
._*

# Editors
*.swp
*~
.idea/
.vscode/

# Python, from brain/bin/* and any measurement scripts
__pycache__/
*.py[cod]
.venv/
venv/

# Local Claude Code state — settings.local.json records this machine's
# permission grants and is not shared configuration.
.claude/settings.local.json
.claude/state/

# Voice profiles never belong in this repository (D0027). The skills read
# them from ~/.claude/voice/profile/, and a team that wants a shared one
# commits it in THEIR repository, not this one. Ignored here so a profile
# built while dogfooding cannot be committed by accident.
voice/profile/
*.profile.md

# Corpora. Nobody's writing samples are ever tracked here (D0017).
corpus/
train/
held_out/

# Generated by brain/bin/graph-build. It embeds the whole brain as JSON, so a
# committed copy goes stale on every node change and duplicates any redaction.
brain/graph.html
